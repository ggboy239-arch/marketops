# Keep the real .env file private. Never upload tokens or API keys to GitHub.
DISCORD_TOKEN=
MARKETAUX_API_KEY=

# Personal OpenAI policy-to-market lesson
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
OPENAI_WEB_SEARCH_TOOL=web_search
POLICY_BRIEF_AUTO_POST=true
POLICY_BRIEF_CHANNEL=openai-news-for-me
POLICY_BRIEF_TIME_PT=05:30
POLICY_BRIEF_WEEKDAYS_ONLY=true
POLICY_BRIEF_CREATE_CHANNEL=true
POLICY_BRIEF_CATCHUP_MINUTES=30
POLICY_BRIEF_LOOKBACK_HOURS=30

# Amazon-to-Amazon Keepa lead scanner
KEEPA_API_KEY=
AMAZON_HOLD_LEADS_CHANNEL_ID=
AMAZON_STOCK_PRESSURE_CHANNEL_ID=
AMAZON_LEAD_REVIEW_CHANNEL_ID=
AMAZON_LEADS_CHECK_MINUTES=30
AMAZON_LEADS_MAX_PRODUCTS=20
AMAZON_LEADS_MIN_PROFIT=10
AMAZON_LEADS_MIN_ROI=40
AMAZON_LEADS_MAX_ROI=100
AMAZON_LEADS_PREFERRED_ROI=50
AMAZON_LEADS_MAX_RANK=150000
AMAZON_LEADS_MIN_MONTHLY_SOLD=30
AMAZON_LEADS_MIN_DROPS_30=10
AMAZON_LEADS_MIN_SELLERS=3
AMAZON_LEADS_MAX_SELLERS=20
AMAZON_LEADS_REFERRAL_RATE=0.15
AMAZON_LEADS_EST_FBA_FEE=4.50

# Storefront monitoring. false backfills a seller once; true alerts only on
# listings first observed after the seller is added.
STOREFRONT_CHECK_MINUTES=10
STOREFRONT_PRODUCTS_PER_SCAN=20
STOREFRONT_PRODUCT_DELAY_SECONDS=20
STOREFRONT_BASELINE_ON_ADD=false

# Probability-based next-session learning journal
TOMORROW_SETUP_CHANNEL=tomorrow-setup
TOMORROW_SETUP_TIME_PT=17:30
TOMORROW_OPEN_CAPTURE_TIME_PT=06:35
TOMORROW_REVIEW_TIME_PT=13:15
TOMORROW_SETUP_AUTO_POST=true
